---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const { header, hero, cta, a11y } = t;
---

<section
  id="hero"
  aria-labelledby="hero-name"
  class="relative overflow-hidden bg-[var(--color-hero-bg)] text-[var(--color-hero-text)] reveal"
>
  <!-- organic background blobs -->
  <div
    class="blob absolute -top-24 -right-24 w-[28rem] h-[28rem] bg-[var(--color-mint-200)] opacity-40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="blob-2 absolute top-1/2 -left-32 w-[20rem] h-[20rem] bg-[var(--color-sun-200)] opacity-30 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative px-6 pt-32 pb-24 max-w-[var(--width-wide)] mx-auto">
    <p
      class="inline-block px-4 py-1.5 rounded-full bg-[var(--color-surface)]/80 border border-[var(--color-mint-300)]/30 font-[family-name:var(--font-ui)] text-xs font-semibold tracking-[0.12em] uppercase text-[var(--color-hero-accent)] mb-6"
    >
      {hero.eyebrow}
    </p>
    <h1
      id="hero-name"
      class="font-[family-name:var(--font-ui)] text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-6 leading-[1.05]"
    >
      {header.name}
    </h1>
    <p
      class="font-[family-name:var(--font-ui)] text-2xl sm:text-3xl font-medium text-[var(--color-sage-700)] mb-3 leading-tight max-w-2xl"
    >
      {hero.tagline}
    </p>
    <p
      class="font-[family-name:var(--font-body)] text-lg text-[var(--color-text-muted)] mb-10 max-w-xl leading-relaxed"
    >
      {hero.sub}
    </p>

    <div class="flex flex-wrap gap-3 items-center">
      <a
        href={`mailto:${header.email}`}
        class="btn-primary shadow-lg shadow-[var(--color-sage-500)]/20"
      >
        {cta.primary}
      </a>
      <a
        href={`https://${header.linkedin}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${a11y.linkedinProfile} ${a11y.opensInNewTab}`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-[var(--color-sage-300)] text-[var(--color-sage-700)] bg-[var(--color-surface)] font-[family-name:var(--font-ui)] text-sm font-medium tracking-wide no-underline transition-colors duration-[var(--duration-base)] hover:border-[var(--color-hero-accent)] hover:text-[var(--color-hero-accent)] motion-reduce:transition-none"
      >
        LinkedIn
      </a>
    </div>

    <!-- location / contact meta -->
    <div
      class="flex flex-wrap gap-x-4 gap-y-2 mt-10 text-sm text-[var(--color-text-muted)] font-[family-name:var(--font-ui)]"
    >
      <span
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-surface)]/70 border border-[var(--color-border)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {header.location}
      </span>
      <a
        href={`https://${header.github}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${a11y.githubProfile} ${a11y.opensInNewTab}`}
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-surface)]/70 border border-[var(--color-border)] no-underline hover:text-[var(--color-hero-accent)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          >
          </path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        {header.github}
      </a>
    </div>
  </div>
</section>
