---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const { craft, a11y } = t;
---

<section
  id="craft"
  aria-labelledby="craft-heading"
  class="bg-[var(--color-craft-bg)] text-[var(--color-craft-text)] reveal py-20 px-6"
>
  <div class="max-w-[var(--width-content)] mx-auto">
    <p
      class="font-[family-name:var(--font-ui)] text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-sage-500)] mb-4"
    >
      {craft.eyebrow}
    </p>
    <h2
      id="craft-heading"
      class="font-[family-name:var(--font-ui)] text-3xl sm:text-4xl font-bold text-[var(--color-sage-900)] mb-4 tracking-tight"
    >
      {craft.heading}
    </h2>
    <p
      class="font-[family-name:var(--font-body)] text-lg text-[var(--color-text-muted)] mb-12 max-w-2xl leading-relaxed"
    >
      {craft.narrative}
    </p>

    <div class="space-y-8">
      {
        craft.institutions.map((school, index) => (
          <article
            class="card-lift p-6 sm:p-8 rounded-[2rem] bg-[var(--color-craft-card)] border border-[var(--color-stone-200)]"
            style={index === 0 ? 'border-color: var(--color-coral-300)' : undefined}
          >
            <div class="flex flex-wrap justify-between items-baseline gap-2 mb-1">
              <div class="flex items-center gap-3">
                <span
                  class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-coral-200)] text-[var(--color-coral-700)]"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M22 10v6" />
                    <path d="M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c3 3 9 3 12 0v-5" />
                  </svg>
                </span>
                <h3 class="font-[family-name:var(--font-ui)] text-lg font-bold text-[var(--color-sage-900)]">
                  {school.name}
                </h3>
              </div>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-coral-100)] font-[family-name:var(--font-ui)] text-xs font-medium text-[var(--color-coral-600)] whitespace-nowrap">
                {school.period}
              </span>
            </div>
            <p class="font-[family-name:var(--font-ui)] text-sm font-semibold text-[var(--color-text-muted)] mb-3">
              {school.degree}
            </p>
            <p class="font-[family-name:var(--font-body)] text-sm text-[var(--color-text-muted)] leading-relaxed">
              {school.description}
            </p>
            {'highlights' in school && school.highlights && (
              <ul class="mt-5 flex flex-wrap gap-2 list-none p-0 m-0" role="list">
                {school.highlights.map((h) => (
                  <li class="inline-block px-3 py-1.5 rounded-full text-xs font-medium font-[family-name:var(--font-ui)] bg-[var(--color-coral-100)] border border-[var(--color-coral-200)] text-[var(--color-coral-700)]">
                    <a
                      href={h.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="no-underline hover:underline hover:text-[var(--color-coral-900)]"
                    >
                      {h.label}
                      <span class="sr-only"> {a11y.opensInNewTab}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
