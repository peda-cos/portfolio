---
interface Props {
  /** visual style of the organic divider */
  variant?: 'wave' | 'cloud' | 'curve' | 'tilt';
  /** CSS fill color for the shape; defaults to current page background */
  fill?: string;
  /** flip the divider vertically (useful between two coloured sections) */
  flip?: boolean;
}

const { variant = 'wave', fill = 'currentColor', flip = false } = Astro.props;

const transform = flip ? 'rotate(180deg)' : undefined;

const wavePath = 'M0,64 C240,128 480,0 720,64 C960,128 1200,0 1440,64 L1440,0 L0,0 Z';
const cloudPath =
  'M0,96 C120,80 200,48 320,48 C400,48 440,80 520,80 C600,80 640,48 720,48 C800,48 840,80 920,80 C1000,80 1040,48 1120,48 C1240,48 1320,80 1440,96 L1440,0 L0,0 Z';
const curvePath = 'M0,96 C360,160 1080,32 1440,96 L1440,0 L0,0 Z';
const tiltPath = 'M0,128 L1440,0 L1440,0 L0,0 Z';

const paths: Record<string, string> = {
  wave: wavePath,
  cloud: cloudPath,
  curve: curvePath,
  tilt: tiltPath,
};
---

<div
  class="w-full overflow-hidden leading-[0]"
  style={transform ? { transform } : undefined}
  aria-hidden="true"
>
  <svg
    class="relative block w-[calc(100%+2px)] h-auto -mx-px"
    viewBox="0 0 1440 128"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d={paths[variant]} fill={fill}></path>
  </svg>
</div>
