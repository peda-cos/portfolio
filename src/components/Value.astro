---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const { value } = t;

const cardStyles = [
  { bg: 'var(--color-value-card-1)', iconBg: 'var(--color-mint-500)' },
  { bg: 'var(--color-value-card-2)', iconBg: 'var(--color-sky-500)' },
  { bg: 'var(--color-value-card-3)', iconBg: 'var(--color-sun-500)' },
  { bg: 'var(--color-value-card-4)', iconBg: 'var(--color-coral-500)' },
];
---

<section
  id="value"
  aria-labelledby="value-heading"
  class="bg-[var(--color-value-bg)] text-[var(--color-value-text)] reveal py-20 px-6"
>
  <div class="max-w-[var(--width-content)] mx-auto">
    <p
      class="font-[family-name:var(--font-ui)] text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-sage-500)] mb-4"
    >
      {value.eyebrow}
    </p>
    <h2
      id="value-heading"
      class="font-[family-name:var(--font-ui)] text-3xl sm:text-4xl font-bold text-[var(--color-sage-900)] mb-4 tracking-tight"
    >
      {value.heading}
    </h2>
    <p
      class="font-[family-name:var(--font-body)] text-lg text-[var(--color-text-muted)] mb-12 max-w-2xl leading-relaxed"
    >
      {value.summary}
    </p>

    <!-- Skill clusters -->
    <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 gap-5">
      {
        value.clusters.map((cluster, index) => {
          const style = cardStyles[index];
          return (
            <div
              class="card-lift p-6 rounded-[2rem] border border-[var(--color-stone-200)]"
              style={`background-color: ${style.bg};`}
            >
              <div class="flex items-center gap-3 mb-4">
                <span
                  class="inline-flex items-center justify-center w-10 h-10 rounded-full text-[var(--color-sage-900)]"
                  style={`background-color: ${style.iconBg};`}
                  aria-hidden="true"
                >
                  {index === 0 && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                      <line x1="8" y1="21" x2="16" y2="21" />
                      <line x1="12" y1="17" x2="12" y2="21" />
                    </svg>
                  )}
                  {index === 1 && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <ellipse cx="12" cy="5" rx="9" ry="3" />
                      <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                    </svg>
                  )}
                  {index === 2 && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                  )}
                  {index === 3 && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  )}
                </span>
                <h3 class="font-[family-name:var(--font-ui)] text-sm font-bold tracking-[0.12em] uppercase text-[var(--color-sage-900)]">
                  {cluster.name}
                </h3>
              </div>
              <ul class="flex flex-wrap gap-2 list-none p-0 m-0" role="list">
                {cluster.items.map((item) => (
                  <li class="inline-block px-3 py-1.5 rounded-full text-sm font-medium font-[family-name:var(--font-ui)] bg-[var(--color-surface)]/80 border border-[var(--color-stone-200)] text-[var(--color-sage-800)]">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
