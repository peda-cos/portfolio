---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const { cta, header } = t;
---

<section
  id="contact"
  aria-labelledby="cta-heading"
  class="relative overflow-hidden bg-[var(--color-cta-bg)] text-[var(--color-cta-text)] reveal py-24 px-6"
>
  <!-- soft organic glow -->
  <div
    class="blob absolute -top-20 -right-20 w-[24rem] h-[24rem] bg-[var(--color-mint-500)] opacity-10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="blob-3 absolute -bottom-20 -left-20 w-[24rem] h-[24rem] bg-[var(--color-sky-500)] opacity-10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-[var(--width-content)] mx-auto text-center">
    <p
      class="inline-block px-4 py-1.5 rounded-full bg-[var(--color-sage-800)] border border-[var(--color-sage-700)] font-[family-name:var(--font-ui)] text-xs font-semibold tracking-[0.12em] uppercase text-[var(--color-cta-accent)] mb-6"
    >
      {cta.eyebrow}
    </p>
    <h2
      id="cta-heading"
      class="font-[family-name:var(--font-ui)] text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-cta-text)] mb-5 tracking-tight"
    >
      {cta.heading}
    </h2>
    <p
      class="font-[family-name:var(--font-body)] text-lg text-[var(--color-stone-300)] mb-10 max-w-md mx-auto leading-relaxed"
    >
      {cta.body}
    </p>
    <a
      href={`mailto:${header.email}`}
      class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-[var(--color-cta-accent)] text-[var(--color-sage-900)] font-[family-name:var(--font-ui)] text-base font-bold no-underline shadow-xl shadow-[var(--color-sage-950)]/30 transition-transform duration-[var(--duration-base)] hover:scale-105 motion-reduce:transition-none"
    >
      {cta.action}
    </a>
    <p class="mt-6 text-sm text-[var(--color-stone-400)] font-[family-name:var(--font-ui)]">
      {header.email}
    </p>
  </div>
</section>
