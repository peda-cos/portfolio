---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const { footer, a11y } = t;
---

<footer class="bg-[var(--color-footer-bg)] text-[var(--color-footer-text)] py-10 px-6 text-center">
  <p class="font-[family-name:var(--font-ui)] text-sm">
    {footer.builtWith}
    <a
      href="https://astro.build"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--color-footer-link)] underline underline-offset-2 hover:text-[var(--color-cta-accent)]"
      >Astro<span class="sr-only"> {a11y.opensInNewTab}</span></a
    >
    {footer.svelte}
    <a
      href="https://svelte.dev"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--color-footer-link)] underline underline-offset-2 hover:text-[var(--color-cta-accent)]"
      >Svelte<span class="sr-only"> {a11y.opensInNewTab}</span></a
    >
    {footer.tailwind}
    <a
      href="https://tailwindcss.com"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--color-footer-link)] underline underline-offset-2 hover:text-[var(--color-cta-accent)]"
      >Tailwind<span class="sr-only"> {a11y.opensInNewTab}</span></a
    >
    {footer.period}
  </p>
</footer>
